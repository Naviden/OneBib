{
  "name": "onebib",
  "version": "1.0.2",
  "description": "Simple, local BibTeX citations for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "check": "npm run lint && npm test && npm run build && node scripts/check-release.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "bibtex",
    "citations",
    "bibliography"
  ],
  "author": "Navid Nobani",
  "license": "MIT",
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "latest",
    "eslint": "latest",
    "eslint-plugin-obsidianmd": "latest",
    "globals": "latest",
    "jiti": "latest",
    "obsidian": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
